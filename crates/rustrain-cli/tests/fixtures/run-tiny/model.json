{
  "format": "rustrain.model.v1",
  "name": "run-tiny",
  "dtype": "bf16",
  "inputs": {
    "input_ids": {
      "shape": [
        "seq"
      ],
      "kind": "input",
      "dtype": "i64"
    }
  },
  "params": {
    "seq": {
      "from": "text_config.max_position_embeddings"
    },
    "hidden": {
      "from": "text_config.hidden_size"
    },
    "inter": {
      "from": "text_config.intermediate_size"
    },
    "vocab": {
      "from": "text_config.vocab_size"
    }
  },
  "templates": {
    "embed": {
      "inputs": {
        "ids": {
          "shape": [
            "seq"
          ],
          "kind": "input",
          "dtype": "i64"
        }
      },
      "outputs": {
        "y": {
          "shape": [
            "seq",
            "hidden"
          ],
          "kind": "activation"
        }
      },
      "slots": [
        {
          "name": "w",
          "kind": "weight",
          "shape": [
            "vocab",
            "hidden"
          ]
        }
      ],
      "nodes": [
        {
          "op": "embedding",
          "in": [
            "w",
            "ids"
          ],
          "out": [
            "y"
          ]
        }
      ]
    },
    "tower": {
      "inputs": {
        "x": {
          "shape": [
            "seq",
            "hidden"
          ],
          "kind": "activation"
        }
      },
      "outputs": {
        "y": {
          "shape": [
            "seq",
            "hidden"
          ],
          "kind": "activation"
        }
      },
      "slots": [
        {
          "name": "w_up",
          "kind": "weight",
          "shape": [
            "hidden",
            "inter"
          ]
        },
        {
          "name": "w_down",
          "kind": "weight",
          "shape": [
            "inter",
            "hidden"
          ]
        },
        {
          "name": "h",
          "kind": "activation",
          "shape": [
            "seq",
            "inter"
          ]
        }
      ],
      "nodes": [
        {
          "op": "linear",
          "in": [
            "x",
            "w_up"
          ],
          "out": [
            "h"
          ]
        },
        {
          "op": "linear",
          "in": [
            "h",
            "w_down"
          ],
          "out": [
            "y"
          ]
        }
      ]
    }
  },
  "stack": [
    {
      "template": "embed",
      "prefix": "embed",
      "inputs": {
        "ids": "input_ids"
      }
    },
    {
      "template": "tower",
      "prefix": "tower",
      "inputs": {
        "x": "embed.y"
      }
    }
  ],
  "binding": [
    {
      "slot": "embed.w",
      "source": "model.embed.weight"
    },
    {
      "slot": "tower.w_up",
      "source": "model.up.weight",
      "transform": [
        "transpose(0,1)"
      ]
    },
    {
      "slot": "tower.w_down",
      "source": "model.down.weight",
      "transform": [
        "transpose(0,1)"
      ]
    }
  ],
  "outputs": {
    "logits": "tower.y",
    "hidden": [
      "embed.y",
      "tower.y"
    ]
  }
}
